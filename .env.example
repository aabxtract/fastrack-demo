# FASTRACK environment configuration
# Copy to .env (already gitignored) and fill in what you use.

# Zero-config model access: set a Groq key and skip `fastrack init` entirely.
# Free key: https://console.groq.com
GROQ_API_KEY=

# Optional: override the default Groq model (default: openai/gpt-oss-120b)
FASTRACK_MODEL=
